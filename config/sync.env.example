# Kopie jako config/sync.env (lokalne, mimo git).
# Tokeny z dashboardu Cloudflare + Render.

# --- Cloudflare Zero Trust / Access ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_APP_ID=
CLOUDFLARE_ACCESS_POLICY_ID=
# Policy "treneri STK" je reusable -> true (default)
CLOUDFLARE_ACCESS_POLICY_REUSABLE=true

# --- Render ---
RENDER_API_KEY=
# RENDER_SERVICE_ID=   # nebo nech prazdne a pouzij jmeno sluzby:
RENDER_SERVICE_NAME=nominace-mcr-beginner-lske-2026

# Po sync CLUB_PASSWORDS spustit redeploy (true/false)
RENDER_REDEPLOY=true

# Trvala zmena hesla z webu: v Render dashboardu nastav stejny RENDER_API_KEY
# (RENDER_SERVICE_ID doplni make sync-trainers automaticky)
