# Kopie jako trainers.yaml (lokalne, mimo git).
# Sync: make sync-trainers  (viz config/sync.env.example)
#
# role stk    -> Cloudflare Access + heslo (bez vyberu role na strance)
# role trener -> Cloudflare Access + heslo, klub z tohoto souboru

trainers:
  - email: stk@example.com
    role: stk
    password: "heslo-stk"

  - email: trener@klub.cz
    role: trener
    club: "GRYF z.s."
    password: "heslo-klubu"
